# ============================================================
# .claudeignore — Claude 프로젝트 컨텍스트에서 제외할 파일/디렉토리
# 토큰 소비 절감 및 불필요한 바이너리·캐시 파일 제외
# ============================================================

# ── 빌드 산출물 ───────────────────────────────────────────
**/build/
**/out/
**/target/
**/.gradle/
**/.idea/
**/*.class
**/*.jar
**/*.war
**/*.ear

# ── Node.js ───────────────────────────────────────────────
**/node_modules/
**/.next/
**/.nuxt/
**/dist/
**/.output/
**/coverage/
**/.turbo/
**/.pnpm-store/
**/.yarn/cache/
**/yarn-error.log
**/npm-debug.log*
**/pnpm-debug.log*

# ── Git ───────────────────────────────────────────────────
**/.git/
**/.gitkeep

# ── OS / IDE ──────────────────────────────────────────────
**/.DS_Store
**/Thumbs.db
**/.vscode/
**/*.iml

# ── 환경변수 (보안) ───────────────────────────────────────
**/.env
**/.env.local
**/.env.*.local

# ── Docker 볼륨·데이터 ────────────────────────────────────
**/data/
**/volumes/

# ── 로그 ──────────────────────────────────────────────────
**/*.log
**/logs/

# ── 이미지·미디어 바이너리 ────────────────────────────────
**/*.jpg
**/*.jpeg
**/*.png
**/*.gif
**/*.webp
**/*.svg
**/*.ico
**/*.mp4
**/*.mp3
**/*.pdf

# ── 테스트 리포트 ─────────────────────────────────────────
**/test-results/
**/reports/

# ── QueryDSL 생성 코드 ────────────────────────────────────
**/generated/
**/src/main/generated/

# ── 기타 압축 파일 ────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.gz



# 로그
logs/
*.log


build.gradle
settings.gradle

**/.vscode/

